// Rendered to wrangler.jsonc by tools/deploy.mjs. Names carry the ps- prefix so nothing collides with another installation in the account.
{
  "name": "{worker_name}",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "{d1_database}", "database_id": "{d1_database_id}", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "workers_dev": true,
  "observability": { "enabled": true }
}
